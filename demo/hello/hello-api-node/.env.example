# Environment Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Feature Flags
DEBUG=false

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/hello_api

# Observability (for future use)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Kafka (Event-Driven Architecture — feature 002-hello-api-eda)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=hello-api-node
KAFKA_TOPIC_HELLO=event.hello.v1
